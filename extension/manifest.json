{
  "manifest_version": 3,
  "name": "Valorant Shop Login Helper",
  "version": "1.4.0",
  "description": "Sends the Riot login redirect back to the Valorant Shop site, and can route Riot login pages through a proxy you run (for networks that block Riot).",
  "permissions": [
    "webNavigation",
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://anton7444.github.io/valorant-shop/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Riot login proxy",
    "default_popup": "popup.html"
  }
}
