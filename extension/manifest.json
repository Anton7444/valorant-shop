{
  "manifest_version": 3,
  "name": "Valorant Shop Login Helper",
  "version": "1.3.0",
  "description": "Automatically sends the Riot login redirect back to the Valorant Shop site.",
  "permissions": [
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://antonfong.dpdns.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
