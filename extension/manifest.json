{
  "manifest_version": 3,
  "name": "Valorant Shop Login Helper",
  "version": "1.4.0",
  "description": "Sends the Riot login redirect back to the Valorant Shop site, together with the Riot session cookie so the site can renew your login by itself.",
  "permissions": [
    "webNavigation",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://anton7444.github.io/valorant-shop/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://auth.riotgames.com/*"
  ]
}
